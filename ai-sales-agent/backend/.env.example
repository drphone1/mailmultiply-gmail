# PostgreSQL Database Connection URL
# Replace with your actual database connection string
DATABASE_URL="postgresql://your_db_user:your_db_password@your_db_host:your_db_port/your_db_name"

# Google Generative AI API Key
GOOGLE_API_KEY="your_google_generative_ai_api_key_here"

# WhatsApp Webhook Verification Token
# This must match the token you set in your WhatsApp App dashboard (Meta Developer Portal)
WHATSAPP_VERIFY_TOKEN="your_chosen_whatsapp_webhook_verify_token"

# Note: WhatsApp Business Account Access Token and Phone Number ID are now managed
# via the database through the /whatsapp_accounts/ API endpoint or the admin panel.
# However, you might need them initially for testing or if you decide to have a fallback.
# WHATSAPP_ACCESS_TOKEN="your_whatsapp_bussiness_api_access_token" (Store in DB instead)
# WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_business_phone_number_id" (Store in DB instead)

# Optional: ChromaDB Path (if you want to change the default from main.py)
# CHROMA_DATA_PATH="../data_chroma"
# COLLECTION_NAME="sales_rag_kb"

# Optional: Default Company Name for Prompts (if not set in WhatsApp Account details)
# DEFAULT_COMPANY_NAME="My Awesome Company"
